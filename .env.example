# --- Resend (catering form emails) — get key at https://resend.com ---
# Add the same keys in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxx
# Where you receive enquiry emails (e.g. your business inbox)
ENQUIRY_TO_EMAIL=you@example.com
# After verifying a domain in Resend, e.g. Catering <catering@yourdomain.com>
# For testing, Resend allows: OlaJesu <onboarding@resend.dev> (only to your own account)
EMAIL_FROM=OlaJesu <onboarding@resend.dev>

# --- Optional: Cloudflare Turnstile (site key is public, secret in Vercel only) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side (never NEXT_PUBLIC_). Required if you show Turnstile in the form.
TURNSTILE_SECRET_KEY=

# --- Payload admin + database ---
# Neon Postgres connection string (Vercel's Neon integration sets this for you).
# Locally, use a separate Neon development branch, never production.
DATABASE_URL=
# Long random string used to sign admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Public URL of the site, e.g. https://olajesu.com (blank is fine locally)
NEXT_PUBLIC_SERVER_URL=
